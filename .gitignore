# Common base — concatenate with template/<lang>/.gitignore

node_modules/
.env
.env.local
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.claude/
# Go-specific — append to common/.gitignore

# Build output
bin/
dist/

# Windows executables
*.exe

# Go test cache / coverage
*.test
*.out
coverage.txt
coverage.out

# goreleaser
.goreleaser-dist/

# Derived release artifact — must not be committed
release-notes.md

# --- project-specific ---

# npm pack output
*.tgz

# Local E2E secrets (never commit)
scripts/e2e.local.ps1
scripts/e2e.local.env
scripts/npm-token.local
scripts/gitlab-runner-e2e.config.toml
.e2e-auth-home/

# E2E test report (generated locally; docs/E2E-ACCEPTANCE-REPORT.* are committed snapshots)
scripts/e2e-report.csv
scripts/e2e-report.log
scripts/e2e-report-verbose.log
scripts/unit-report.log

# coverage (go test -coverprofile / parallel agent runs)
cov.out
cov
coverage
coverage.html
*_cov
*_cov.*
*cov.html
cover_report/
out_cov/
cover_*.txt
cmd/authcov3
internal/output/out
